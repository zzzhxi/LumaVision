# Copy to /etc/lumavision/lumavision.env, owned by root and mode 0600.
LUMA_PUBLIC_ORIGIN=https://gallery.example.com
ADMIN_EMAILS=
AUTH_EMAIL_DEMO=false

# Choose one provider and configure its credentials.
AUTH_EMAIL_PROVIDER=gmail
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# For Resend set AUTH_EMAIL_PROVIDER=resend, then configure:
# RESEND_API_KEY=
# AUTH_EMAIL_FROM="LumaVision <sender@example.com>"
